 "utterances": [
  {
   "i": 0,
   "text": "Thank you for calling. Before I make any change, let me read back what I have.",
   "onset_ms": 500,
   "end_ms": 4760
  },
  {
   "i": 1,
   "text": "The phone number on file is four one five, five five five, zero one four two.",
   "onset_ms": 5560,
   "end_ms": 10740
  },
  {
   "i": 2,
   "text": "The appointment is on Tuesday, November eleventh, at ten thirty in the morning, with Doctor Patel.",
   "onset_ms": 11540,
   "end_ms": 16720
  },
  {
   "i": 3,
   "text": "Your account balance is one hundred and twenty dollars, and the refund cap is fifty dollars.",
   "onset_ms": 17520,
   "end_ms": 22520
  },
  {
   "i": 4,
   "text": "The zip code is nine four one zero seven, dash two two one eight.",
   "onset_ms": 23320,
   "end_ms": 27640
  },
  {
   "i": 5,
   "text": "The confirmation code is R T, four four seven one.",
   "onset_ms": 28440,
   "end_ms": 32080
  },
  {
   "i": 6,
   "text": "If anything in that is wrong, please stop me and I will correct it.",
   "onset_ms": 32880,
   "end_ms": 36540
  },
  {
   "i": 7,
   "text": "One moment while I check the system.",
   "onset_ms": 37340,
   "end_ms": 39260
  },
  {
   "i": 8,
   "text": "The payment did not go through, so nothing was charged to your card.",
   "onset_ms": 40060,
   "end_ms": 43600
  },
  {
   "i": 9,
   "text": "I can refund up to the cap today, and a supervisor can approve more.",
   "onset_ms": 44400,
   "end_ms": 48200
  },
  {
   "i": 10,
   "text": "Could you spell your email address for me, one letter at a time?",
   "onset_ms": 49000,
   "end_ms": 52340
  },
  {
   "i": 11,
   "text": "I have updated the address to twelve Market Street, apartment four.",
   "onset_ms": 53140,
   "end_ms": 56780
  },
  {
   "i": 12,
   "text": "Is there anything else I can help you with before we end the call?",
   "onset_ms": 57580,
   "end_ms": 60380
  },
  {
   "i": 13,
   "text": "Thank you, and have a good day.",
   "onset_ms": 61180,
   "end_ms": 62760
  },
  {
   "i": 14,
   "text": "Let me pull up the account ending in seven seven, one moment please.",
   "onset_ms": 63560,
   "end_ms": 66780
  },
  {
   "i": 15,
   "text": "I see two appointments: one with Doctor Lee on Wednesday at eleven, and one with Doctor Patel on Thursday at two.",
   "onset_ms": 67580,
   "end_ms": 74660
  },
  {
   "i": 16,
   "text": "To verify your identity, I need your date of birth and the zip code on the account.",
   "onset_ms": 75460,
   "end_ms": 79520
  },
  {
   "i": 17,
   "text": "I have July fourteenth, nineteen fifty eight, and six zero six one four. Is that right?",
   "onset_ms": 80320,
   "end_ms": 85860
  },
  {
   "i": 18,
   "text": "The last payment of forty two dollars and ten cents posted on November third.",
   "onset_ms": 86660,
   "end_ms": 90840
  },
  {
   "i": 19,
   "text": "I can move the Wednesday visit to Friday at nine fifteen, if that works for you.",
   "onset_ms": 91640,
   "end_ms": 95840
  },
  {
   "i": 20,
   "text": "Your new confirmation number is A P, one zero three.",
   "onset_ms": 96640,
   "end_ms": 100100
  },
  {
   "i": 21,
   "text": "The reference for this call is nine nine two, dash four four one.",
   "onset_ms": 100900,
   "end_ms": 104800
  },
  {
   "i": 22,
   "text": "Please hold for a moment while the system processes the refund.",
   "onset_ms": 105600,
   "end_ms": 108540
  },
  {
   "i": 23,
   "text": "The refund of fifty dollars will reach your card in three to five business days.",
   "onset_ms": 109340,
   "end_ms": 113060
  },
  {
   "i": 24,
   "text": "I am sorry, I did not catch that. Could you repeat the last four digits?",
   "onset_ms": 113860,
   "end_ms": 118080
  },
  {
   "i": 25,
   "text": "I have three one two, five five five, zero one one one as the callback number.",
   "onset_ms": 118880,
   "end_ms": 124660
  },
  {
   "i": 26,
   "text": "The office is at two hundred Main Street, suite three hundred, and parking is behind the building.",
   "onset_ms": 125460,
   "end_ms": 130280
  },
  {
   "i": 27,
   "text": "You can bring a photo ID and your insurance card to the first visit.",
   "onset_ms": 131080,
   "end_ms": 134320
  },
  {
   "i": 28,
   "text": "The co-pay is twenty five dollars, due at check in.",
   "onset_ms": 135120,
   "end_ms": 137960
  },
  {
   "i": 29,
   "text": "I have cancelled the Thursday appointment and kept the Friday one.",
   "onset_ms": 138760,
   "end_ms": 141860
  },
  {
   "i": 30,
   "text": "Would you like a text reminder the day before, or an email?",
   "onset_ms": 142660,
   "end_ms": 145820
  },
  {
   "i": 31,
   "text": "The email on file is leo dot park at example dot com.",
   "onset_ms": 146620,
   "end_ms": 150220
  },
  {
   "i": 32,
   "text": "I will send the summary to that address in the next few minutes.",
   "onset_ms": 151020,
   "end_ms": 153680
  },
  {
   "i": 33,
   "text": "There is a late fee of fifteen dollars on the account, and I can waive it once.",
   "onset_ms": 154480,
   "end_ms": 158360
  },
  {
   "i": 34,
   "text": "The balance after the waiver is one hundred and five dollars.",
   "onset_ms": 159160,
   "end_ms": 162300
  },
  {
   "i": 35,
   "text": "Your account number is A C, dash seven seven.",
   "onset_ms": 163100,
   "end_ms": 166200
  },
  {
   "i": 36,
   "text": "The next statement closes on the twentieth, and payment is due on the fifth.",
   "onset_ms": 167000,
   "end_ms": 170620
  },
  {
   "i": 37,
   "text": "I have noted that you prefer morning appointments.",
   "onset_ms": 171420,
   "end_ms": 173660
  },
  {
   "i": 38,
   "text": "If you need to reach us after hours, the line is open until eight in the evening.",
   "onset_ms": 174460,
   "end_ms": 178700
  },
  {
   "i": 39,
   "text": "Let me repeat the time once more: Friday, November fourteenth, at nine fifteen in the morning.",
   "onset_ms": 179500,
   "end_ms": 185000
  },
  {
   "i": 40,
   "text": "Is there anything in that summary I should change?",
   "onset_ms": 185800,
   "end_ms": 188400
  },
  {
   "i": 41,
   "text": "Thank you for your patience today, and take care.",
   "onset_ms": 189200,
   "end_ms": 191440
  }
